NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://bifrost:bifrost@localhost:5433/bifrost
REDIS_URL=redis://localhost:6380

# 290 = 2.9%, retained on every capture.
PLATFORM_FEE_BPS=290
# Real PSPs use ~7 days; short defaults here so sweeper behaviour is observable in a demo run.
HOLD_EXPIRY_SECONDS=30
PAYOUT_MATURITY_SECONDS=30

OUTBOX_RELAY_POLL_MS=2000
SWEEPER_POLL_MS=5000
